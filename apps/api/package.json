{
  "name": "@softlans/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit.test.ts tests/deployment.test.ts tests/startup-diagnostics.test.ts tests/server.test.ts",
    "test:integration": "vitest run tests/integration.test.ts tests/database.test.ts tests/students.test.ts tests/groups.test.ts tests/schedules.test.ts tests/billing.test.ts tests/debts.test.ts tests/payroll.test.ts tests/telegram.test.ts",
    "seed:dev": "tsx src/scripts/seed.ts",
    "provision:super-admin": "tsx src/scripts/super-admin.ts",
    "telegram:dispatch": "tsx src/scripts/telegram-dispatch.ts"
  },
  "dependencies": {
    "@softlans/contracts": "*",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "grammy": "^1.46.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.12",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.2.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6"
  }
}
