NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
# MongoDB replica set is required for atomic owner + tenant registration.
MONGODB_URI=mongodb://127.0.0.1:27017/softlans_edu?replicaSet=rs0
# Generate a unique random value with the command in README. Never commit .env.
JWT_SECRET=
TRUST_PROXY_HOPS=0
# Demo mode defaults public registration to disabled; local development stays open.
DEMO_MODE=false
# Optional explicit override (true/false); omit to follow DEMO_MODE.
# PUBLIC_REGISTRATION_ENABLED=false
# Optional scripts only; fill temporarily, then remove.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PASSWORD=
SEED_DEMO=false
SEED_PASSWORD=
