NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
# MongoDB replica set is required for atomic owner + tenant registration.
MONGODB_URI=mongodb://127.0.0.1:27017/softlans_edu?replicaSet=rs0
# Generate a unique random value with the command in README. Never commit .env.
JWT_SECRET=
TRUST_PROXY_HOPS=0
# Demo mode defaults public registration to disabled; local development stays open.
DEMO_MODE=false
# Optional explicit override (true/false); omit to follow DEMO_MODE.
# PUBLIC_REGISTRATION_ENABLED=false
# Optional scripts only; fill temporarily, then remove.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PASSWORD=
SEED_DEMO=false
SEED_PASSWORD=

# Optional central Telegram integration. Backend only; never use VITE_ prefixes.
# Missing/invalid settings disable Telegram without disabling CRM.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Optional NOTIFICATION_SCHEDULER_SECRET: a separate random 43–128 character secret.
# Leave this variable absent to disable the machine-to-machine trigger.
# Store it only in Render and the external scheduler's Authorization header.
