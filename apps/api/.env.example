NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
# MongoDB replica set is required for atomic owner + tenant registration.
MONGODB_URI=mongodb://127.0.0.1:27017/softlans_edu?replicaSet=rs0
# Generate a unique random value with the command in README. Never commit .env.
JWT_SECRET=
TRUST_PROXY_HOPS=0
# Demo mode defaults public registration to disabled; local development stays open.
DEMO_MODE=false
# Optional explicit override (true/false); omit to follow DEMO_MODE.
# PUBLIC_REGISTRATION_ENABLED=false
# Optional scripts only; fill temporarily, then remove.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PASSWORD=
SEED_DEMO=false
SEED_PASSWORD=

# Optional central Telegram integration. Backend only; never use VITE_ prefixes.
# Missing/invalid settings disable Telegram without disabling CRM.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Optional NOTIFICATION_SCHEDULER_SECRET: a separate random 43–128 character secret.
# Leave this variable absent to disable the machine-to-machine trigger.
# Store it only in Render and the external scheduler's Authorization header.

# Password recovery stays OFF until an approved HTTPS email gateway is configured
# and real inbox delivery is verified. Never use a test mailbox in production.
PASSWORD_RECOVERY_ENABLED=false
PASSWORD_EMAIL_DELIVERY_VERIFIED=false
# PASSWORD_EMAIL_ENDPOINT=https://approved-gateway.example/send
# PASSWORD_EMAIL_API_KEY=<separate gateway credential, at least 32 characters>
# PASSWORD_EMAIL_FROM=recovery@your-verified-domain.example

# MFA encryption: server-only, independent 32-byte AES key. Keep absent until provisioned.
# Generate separately with: openssl rand -hex 32
# Back up securely with the database; never prefix with VITE_ or commit its value.
# MFA_ENCRYPTION_KEY=<64 hexadecimal characters>
# Operator activation only after ALL active Super Admins enroll and test recovery.
SUPER_ADMIN_MFA_ENFORCED=false
# Optional deployment-start UTC timestamp (must be in the past). Legacy JWTs are
# accepted for at most one hour after this instant; then remove this setting.
# SESSION_LEGACY_ISSUED_BEFORE=2026-01-01T00:00:00.000Z

# Phase 6.4.4: tune stale threshold above scheduler interval + planning/delivery time.
MONITOR_SCHEDULER_STALE_SECONDS=180
MONITOR_BACKLOG_THRESHOLD=100
# Disabled until operator approves the dedicated bot/private destination and staged drill.
OPERATOR_ALERTS_ENABLED=false
OPERATOR_ALERTS_SUPPRESSED=false
OPERATOR_ALERT_COOLDOWN_MINUTES=30
# Separate from the CRM bot; do not configure a webhook for the operator bot.
# OPERATOR_TELEGRAM_BOT_TOKEN=<dedicated bot credential>
# OPERATOR_TELEGRAM_CHAT_ID=<private operator chat/group ID; never a customer destination>
